<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="璦閣輸入法 設定"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginBottom="24dp" />

        <!-- ===================== 輸入設定 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="輸入設定"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="預設輸入模式"
            android:textSize="14sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_input_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="鍵盤大小"
            android:textSize="14sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_keyboard_scale"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="倒退鍵位置"
            android:textSize="14sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_delete_key"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <Switch
            android:id="@+id/switch_vibrate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="按鍵震動回饋"
            android:textSize="16sp" />

        <LinearLayout
            android:id="@+id/vibrate_strength_row"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:text="震動強度"
                android:textSize="16sp" />

            <SeekBar
                android:id="@+id/seek_vibrate_strength"
                android:layout_width="0dp"
                android:layout_weight="1.6"
                android:layout_height="wrap_content"
                android:max="100" />

            <TextView
                android:id="@+id/tv_vibrate_strength"
                android:layout_width="34dp"
                android:layout_height="wrap_content"
                android:text="50"
                android:textSize="14sp"
                android:textColor="#5F6368"
                android:textAlignment="center" />
        </LinearLayout>

        <Switch
            android:id="@+id/switch_sound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="按鍵音效"
            android:textSize="16sp" />

        <Switch
            android:id="@+id/switch_full_width"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="全形輸出（數字與符號）"
            android:textSize="16sp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- ===================== 佈景主題 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="佈景主題"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <tw.igg.boshiamyime.ui.KeyboardPreviewView
            android:id="@+id/preview_keyboard"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="主題模式"
            android:textSize="14sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="4dp" />

        <Spinner
            android:id="@+id/spinner_theme_mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:id="@+id/custom_theme_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="鍵盤背景色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_theme_bg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="色塊"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_theme_bg"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:hint="#RRGGBB"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:digits="0123456789ABCDEFabcdef#"
                    android:gravity="center_horizontal"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按鍵文字色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_theme_text"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="色塊"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_theme_text"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:hint="#RRGGBB"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:digits="0123456789ABCDEFabcdef#"
                    android:gravity="center_horizontal"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按鍵背景色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_theme_keybg"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="色塊"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_theme_keybg"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:hint="#RRGGBB"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:digits="0123456789ABCDEFabcdef#"
                    android:gravity="center_horizontal"
                    android:textSize="14sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按鍵框線色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <Button
                    android:id="@+id/btn_theme_border"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="match_parent"
                    android:text="色塊"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/et_theme_border"
                    android:layout_width="0dp"
                    android:layout_weight="1.4"
                    android:layout_height="match_parent"
                    android:layout_marginStart="8dp"
                    android:hint="#RRGGBB"
                    android:inputType="textCapCharacters"
                    android:maxLines="1"
                    android:digits="0123456789ABCDEFabcdef#"
                    android:gravity="center_horizontal"
                    android:textSize="14sp" />
            </LinearLayout>

            <Button
                android:id="@+id/btn_theme_reset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="恢復預設色彩"
                android:textSize="14sp"
                android:layout_marginBottom="16dp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- ===================== 碼表管理 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="碼表管理"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_dict_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目前版本：載入中..."
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <TextView
                android:id="@+id/tv_dict_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="碼表筆數：--"
                android:textSize="14sp"
                android:textColor="#5F6368" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_update_dict"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="從 GitHub 下載最新碼表"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progress_update"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- ===================== 版本更新 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="版本更新"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_app_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="目前版本：--"
            android:textSize="14sp"
            android:textColor="#5F6368" />

        <Button
            android:id="@+id/btn_check_update"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="檢查更新"
            android:textSize="14sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_update_status2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- ===================== 資料管理 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="資料管理"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_clear_data"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="清除學習資料（聯想詞）"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_export_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="匯出設定"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <Button
            android:id="@+id/btn_import_settings"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="匯入設定"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- ===================== 關於 ===================== -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="關於"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="璦閣輸入法 v1.0.7&#10;自訂嘸蝦米輸入法 Android App&#10;&#10;© 2026 璦閣數位科技&#10;本專案以 GPL-3.0 授權釋出（Open Source）&#10;&#10;碼表來源：chinese-opendesktop/cin-tables&#10;（碼表授權請以原始來源為準）"
            android:textSize="13sp"
            android:textColor="#5F6368"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>