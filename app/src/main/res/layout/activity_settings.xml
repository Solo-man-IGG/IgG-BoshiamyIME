<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boshiamy IME 設定"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#202124"
            android:layout_marginBottom="24dp" />

        <!-- 輸入模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="輸入模式"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_input_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_t9"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="T9 大按鍵模式（建議）"
                android:textSize="16sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_qwerty"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="QWERTY 鍵盤模式"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_zhuyin"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="注音輸入模式（備用）"
                android:textSize="16sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 嘸蝦米模式 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="嘸蝦米模式"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rg_boshiamy_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <RadioButton
                android:id="@+id/rb_standard"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="標準模式"
                android:textSize="16sp"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rb_simplified"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="簡速模式"
                android:textSize="16sp" />

            <RadioButton
                android:id="@+id/rb_eten"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="倚天模式"
                android:textSize="16sp" />
        </RadioGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 碼表管理 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="碼表管理"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="8dp">

            <TextView
                android:id="@+id/tv_dict_version"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="目前版本：載入中..."
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <TextView
                android:id="@+id/tv_dict_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="碼表筆數：--"
                android:textSize="14sp"
                android:textColor="#5F6368" />
        </LinearLayout>

        <Button
            android:id="@+id/btn_update_dict"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="從 GitHub 下載最新碼表"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progress_update"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/tv_update_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="12sp"
            android:textColor="#5F6368"
            android:layout_marginBottom="16dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 佈景主題 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="佈景主題"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="鍵盤背景色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <Button
                android:id="@+id/btn_theme_bg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="選擇顏色"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按鍵文字色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <Button
                android:id="@+id/btn_theme_text"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="選擇顏色"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按鍵背景色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <Button
                android:id="@+id/btn_theme_keybg"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="選擇顏色"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="按鍵框線色"
                android:textSize="14sp"
                android:textColor="#5F6368" />

            <Button
                android:id="@+id/btn_theme_border"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="選擇顏色"
                android:textSize="14sp"
                android:layout_marginBottom="8dp" />

            <Button
                android:id="@+id/btn_theme_reset"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:text="恢復預設色彩"
                android:textSize="14sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E0E0E0"
            android:layout_marginBottom="16dp" />

        <!-- 其他設定 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="其他設定"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_full_width"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="預設全形輸出"
            android:textSize="16sp"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_vibrate"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="按鍵震動回饋"
            android:textSize="16sp"
            android:checked="true"
            android:layout_marginBottom="8dp" />

        <Switch
            android:id="@+id/switch_sound"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:text="按鍵音效"
            android:textSize="16sp"
            android:layout_marginBottom="24dp" />

        <!-- 關於 -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="關於"
            android:textSize="14sp"
            android:textColor="#1A73E8"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Boshiamy IME v1.0.0&#10;自訂嘸蝦米輸入法 Android App&#10;&#10;碼表來源：chinese-opendesktop/cin-tables&#10;授權：Free for non-commercial use"
            android:textSize="13sp"
            android:textColor="#5F6368"
            android:lineSpacingExtra="4dp" />

    </LinearLayout>
</ScrollView>
